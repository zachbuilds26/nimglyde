# Copy this to .env and fill in. Never commit .env (it holds secrets).
# The frontend bundle is public - keys must ONLY live here on the backend.

PORT=8787

# AI provider - pick one. Backend works without keys (grounded fallback),
# but real AI answers need one of these:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Nimiq payments - your wallet that receives Pro/Super upgrades
MERCHANT_NIM_ADDRESS=NQ07 0000 0000 0000 0000 0000 0000 0000 0000
# Public Nimiq JSON-RPC for balance + payment verification
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Pro pricing in NIM (configurable for MVP/testnet - set to 1 for testing)
PRO_PRICE_NIM=100
SUPER_PRICE_NIM=500
TRIAL_DAYS=3

# Testnet only: allow verify without on-chain check. NEVER true in production.
DEV_BYPASS_VERIFY=false

# Where the frontend lives (for CORS). Comma-separated, e.g. http://192.168.1.42:5173,https://nimglyde.app
# Never "*" outside local dev - the server refuses to boot with "*" unless NODE_ENV is development/test.
ALLOW_ORIGINS=http://localhost:5173
